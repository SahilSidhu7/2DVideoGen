{
  "width": 854,
  "height": 480,
  "fps": 30,
  "duration": 8,
  "background": [6, 6, 14],
  "supersample": 2,
  "axes": false,
  "view": { "xmin": -1.6, "xmax": 1.6, "ymin": -0.9, "ymax": 0.9 },
  "layers": [
    {
      "type": "parametric",
      "t": [0, 6.283185, 3000],
      "params": { "a": 3, "b": 2 },
      "x": "sin(a*t + 0.5*time)",
      "y": "sin(b*t)",
      "color": [90, 210, 255],
      "width": 2
    },
    {
      "type": "explicit",
      "y": "0.4*sin(3*x + time)",
      "color": [255, 140, 90],
      "width": 1
    }
  ]
}
